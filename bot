TOKEN_CACHE_FILE = Path(__file__).resolve().parent / ".fyers_token"

def extract_auth_code(input_str: str) -> str:
    """Extract auth_code whether the user pasted a raw code or full redirected URL."""
    input_str = input_str.strip()
    if not input_str:
        return ""
    if "auth_code=" in input_str:
        parsed = urllib.parse.urlparse(input_str)
        params = urllib.parse.parse_qs(parsed.query)
        if "auth_code" in params:
            return params["auth_code"][0]
    if "code=" in input_str:
        parsed = urllib.parse.urlparse(input_str)
        params = urllib.parse.parse_qs(parsed.query)
        if "code" in params:
            return params["code"][0]
    return input_str

def authenticate_fyers(client_id: str, secret_key: str, redirect_uri: str = "https://trade.fyers.in/api-login/redirect-uri-result.html") -> str:
    """
    Performs interactive OAuth authentication to generate a valid FYERS API v3 access token.
    """
    from fyers_apiv3 import fyersModel

    session = fyersModel.SessionModel(
        client_id=client_id,
        secret_key=secret_key,
        redirect_uri=redirect_uri,
        response_type="code",
        grant_type="authorization_code"
    )

    auth_url = session.generate_authcode()
    print("\n" + "=" * 65)
    print("                FYERS API v3 AUTHENTICATION")
    print("=" * 65)
    print("Please open this link in your browser to log in:")
    print(auth_url)
    print("-" * 65)

    try:
        webbrowser.open(auth_url)
    except Exception:
        pass

    user_input = input("Paste the redirected URL or auth_code here: ").strip()
    auth_code = extract_auth_code(user_input)

    if not auth_code:
        raise ValueError("Invalid or empty auth code provided.")

    session.set_token(auth_code)
    response = session.generate_token()

    if isinstance(response, dict) and response.get("s") == "ok":
        access_token = response.get("access_token")
        # Cache token locally
        with open(TOKEN_CACHE_FILE, "w", encoding="utf-8") as f:
            f.write(access_token)
        print("[+] Authentication Successful! Access token cached locally.")
        return access_token
    else:
        raise RuntimeError(f"Failed to generate access token: {response}")

def get_cached_access_token() -> str:
    """Retrieves cached access token if available."""
    if TOKEN_CACHE_FILE.exists():
        try:
            with open(TOKEN_CACHE_FILE, "r", encoding="utf-8") as f:
                return f.read().strip()
        except Exception:
            return ""
    return ""


class FyersDataConnector:
    """
    Connects to FYERS API v3 to pull historical OHLCV data for backtesting.
    Requires: pip install fyers-apiv3
    """
    def __init__(self, client_id=None, access_token=None):
        self.client_id = client_id
        self.access_token = access_token
        self.fyers = None
        
        if client_id and access_token:
            from fyers_apiv3 import fyersModel
            self.fyers = fyersModel.FyersModel(
                client_id=self.client_id, 
                is_async=False, 
                token=self.access_token, 
                log_path=""
            )

    def fetch_historical_candles(self, symbol="NSE:SBIN-EQ", resolution="15", days_back=30):
        """Fetches candles from FYERS. Falls back to synthetic candles if no API keys are provided."""
        if self.fyers:
            now = datetime.now()
            start_date = now - timedelta(days=days_back)
            
            # FYERS limits intraday historical data requests to chunks of ~90-100 days
            chunk_days = 90 if resolution != "D" else 360
            curr_start = start_date
            all_candles = []
            
            print(f"[*] Fetching {symbol} [{resolution}] from FYERS API ({days_back} days back)...")
            
            while curr_start < now:
                curr_end = min(curr_start + timedelta(days=chunk_days), now)
                
                # FYERS expects YYYY-MM-DD date strings when date_format="1"
                range_from = curr_start.strftime("%Y-%m-%d")
                range_to = curr_end.strftime("%Y-%m-%d")
                
                data = {
                    "symbol": symbol,
                    "resolution": resolution,
                    "date_format": "1",
                    "range_from": range_from,
                    "range_to": range_to,
                    "cont_flag": "1"
                }
                
                try:
                    response = self.fyers.history(data=data)
                    if isinstance(response, dict) and response.get("s") == "ok":
                        candles = response.get("candles", [])
                        all_candles.extend(candles)
                    else:
                        msg = response.get("message", "Failed to fetch history") if isinstance(response, dict) else str(response)
                        print(f"[FYERS API Warning]: {msg}")
                except Exception as e:
                    print(f"[FYERS API Exception]: {e}")
                
                curr_start = curr_end + timedelta(days=1)
            
            if all_candles:
                # Deduplicate candles by epoch timestamp
                seen_epochs = set()
                unique_candles = []
                for c in all_candles:
                    if c[0] not in seen_epochs:
                        seen_epochs.add(c[0])
                        unique_candles.append(c)
                unique_candles.sort(key=lambda x: x[0])
                print(f"[+] Successfully fetched {len(unique_candles)} live candles from FYERS API.")
                return unique_candles

        # Fallback synthetic candle generator for offline testing
        print("[!] Using fallback synthetic candle generator (no live API connection or empty response).")
        return self._generate_synthetic_fyers_data(num_candles=120)

    def _generate_synthetic_fyers_data(self, num_candles=120):
        candles = []
        base_price = 500.0
        curr_time = int(datetime.now().timestamp()) - (num_candles * 900)
        
        random.seed(42)
        for i in range(num_candles):
            drift = 1.2 if 20 <= i <= 60 else (-1.0 if 60 < i <= 90 else 0.1)
            change = drift + random.uniform(-2.5, 2.5)
            base_price = max(10.0, base_price + change)
            
            open_p = base_price - random.uniform(-0.5, 0.5)
            high_p = max(open_p, base_price) + random.uniform(0.5, 2.5)
            low_p = min(open_p, base_price) - random.uniform(0.5, 2.5)
            close_p = base_price
            vol = int(random.uniform(10000, 50000) * (2.0 if abs(change) > 1.5 else 1.0))
            
            candles.append([curr_time + (i * 900), open_p, high_p, low_p, close_p, vol])
        return candles


