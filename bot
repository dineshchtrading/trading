# 3. THREE DISTINCT QUANT RISK ENGINES
# =====================================================================

class DefensiveRiskEngine:
    """
    ENGINE 1: High Volatility / Bearish Regime
    Focus: Capital preservation, tight ATR stops, fractional Kelly reduction.
    """
    def __init__(self, risk_fraction=0.005, atr_mult=1.8, kelly_frac=0.25):
        self.risk_fraction = risk_fraction  # 0.5% risk
        self.atr_mult = atr_mult            # Tight 1.8x ATR trailing stop
        self.kelly_frac = kelly_frac

    def get_position_params(self, capital, price, atr, win_rate=0.48, win_loss_ratio=1.5):
        # Fractional Kelly sizing adjustment
        b = win_loss_ratio
        p = win_rate
        kelly_f = max(0.01, (p * b - (1 - p)) / b) * self.kelly_frac
        
        dollar_risk = capital * min(self.risk_fraction, kelly_f)
        stop_dist = max(0.5, atr * self.atr_mult)
        units = int(dollar_risk / stop_dist)
        return max(1, units), stop_dist, "DEFENSIVE (Tight Stop & Quarter Kelly)"


class StandardRiskEngine:
    """
    ENGINE 2: Normal Volatility / Ranging Regime
    Focus: Balanced 1% risk per trade with standard 2.5x ATR trailing stop.
    """
    def __init__(self, risk_fraction=0.010, atr_mult=2.5):
        self.risk_fraction = risk_fraction  # 1.0% risk
        self.atr_mult = atr_mult            # Standard 2.5x ATR trailing stop

    def get_position_params(self, capital, price, atr, win_rate=0.52, win_loss_ratio=2.0):
        dollar_risk = capital * self.risk_fraction
        stop_dist = max(0.5, atr * self.atr_mult)
        units = int(dollar_risk / stop_dist)
        return max(1, units), stop_dist, "STANDARD (Fixed 1% Risk & 2.5x ATR)"


class AggressiveRiskEngine:
    """
    ENGINE 3: Low Volatility / Strong Trend Expansion Regime
    Focus: Maximizes returns during strong trends with wider stops & higher risk.
    """
    def __init__(self, risk_fraction=0.020, atr_mult=3.5):
        self.risk_fraction = risk_fraction  # 2.0% risk
        self.atr_mult = atr_mult            # Wide 3.5x ATR to avoid early exit

    def get_position_params(self, capital, price, atr, win_rate=0.55, win_loss_ratio=2.5):
        dollar_risk = capital * self.risk_fraction
        stop_dist = max(0.5, atr * self.atr_mult)
        units = int(dollar_risk / stop_dist)
        return max(1, units), stop_dist, "AGGRESSIVE (Expanded 2% Risk & Wide 3.5x ATR)"


# =====================================================================
# 4. REGIME-AWARE RISK SELECTOR ENGINE
# =====================================================================

class AdaptiveRegimeRiskManager:
    """
    Evaluates market condition (ATR % relative to price) and routes 
    orders to the appropriate Risk Engine dynamically.
    """
    def __init__(self):
        self.defensive_engine = DefensiveRiskEngine()
        self.standard_engine = StandardRiskEngine()
        self.aggressive_engine = AggressiveRiskEngine()

    def select_engine_and_size(self, capital, price, atr, rsi):
        atr_pct = (atr / price) * 100.0 if price > 0 else 0.0

        # Regime 1: Extreme Volatility (ATR > 2.5%) -> Defensive Engine
        if atr_pct > 2.5:
            units, stop_dist, name = self.defensive_engine.get_position_params(capital, price, atr)
            return units, stop_dist, name, "HIGH_VOLATILITY"

        # Regime 2: Low Volatility & Strong Trend (ATR < 1.2% & RSI > 52) -> Aggressive Engine
        elif atr_pct < 1.2 and rsi > 52.0:
            units, stop_dist, name = self.aggressive_engine.get_position_params(capital, price, atr)
            return units, stop_dist, name, "TREND_EXPANSION"

        # Regime 3: Normal Conditions -> Standard Engine
        else:
            units, stop_dist, name = self.standard_engine.get_position_params(capital, price, atr)
            return units, stop_dist, name, "NORMAL_MARKET"


