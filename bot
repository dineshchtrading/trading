def save_trades_to_csv(trades_log, output_path="trades_data.csv"):
    """Saves all backtested trade records to a local CSV file."""
    if not trades_log:
        print("[!] No trades were executed during this backtest run.")
        return

    fieldnames = [
        "trade_id", "entry_bar", "entry_time", "entry_price", "units",
        "regime", "risk_engine", "exit_bar", "exit_time", "exit_price",
        "exit_reason", "pnl", "pnl_pct", "balance"
    ]
    
    with open(output_path, mode="w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(trades_log)

    print(f"\n[+] All {len(trades_log)} trades successfully saved locally to: {output_path}")

def format_candle_time(epoch_val):
    """Format candle timestamp to readable datetime string."""
    try:
        return datetime.fromtimestamp(epoch_val).strftime("%Y-%m-%d %H:%M:%S")
    except Exception:
        return str(epoch_val)

def run_fyers_backtest(client_id=None, access_token=None, symbol="NSE:SBIN-EQ", resolution="15", days_back=30, output_csv="trades_data.csv"):
    # Initialize Data Connector and Risk Manager
    fyers_connector = FyersDataConnector(client_id, access_token)
    risk_manager = AdaptiveRegimeRiskManager()
    
    candles = fyers_connector.fetch_historical_candles(symbol=symbol, resolution=resolution, days_back=days_back)
    print(f"Loaded {len(candles)} candles for backtest execution.\n")
    
    initial_capital = 100000.0
    capital = initial_capital
    highs, lows, closes, volumes = [], [], [], []
    
    position = None # "LONG" or None
    units = 0
    entry_price = 0.0
    stop_loss = 0.0
    highest_price = 0.0
    
    # Trade logging structure
    trades_log = []
    current_trade = None
    
    print("=" * 95)
    print(f"{'BAR':<5} | {'TIME':<19} | {'CLOSE':<8} | {'REGIME':<15} | {'RISK ENGINE':<32} | {'ACTION / STATUS'}")
    print("=" * 95)
    
    for idx, c in enumerate(candles):
        # FYERS candle unpacking: [ts, open, high, low, close, volume]
        ts, open_p, high_p, low_p, close_p, vol = c
        candle_time_str = format_candle_time(ts)
        
        highs.append(high_p)
        lows.append(low_p)
        closes.append(close_p)
        volumes.append(vol)
        
        if len(closes) < 30:
            continue
            
        macd, signal, hist = calculate_macd(closes)
        rsi = calculate_rsi(closes)
        atr = calculate_atr(highs, lows, closes)
        
        # Route to appropriate Risk Engine
        req_units, stop_dist, engine_name, regime = risk_manager.select_engine_and_size(capital, close_p, atr, rsi)
        
        # --- POSITION MANAGEMENT (In a Trade) ---
        if position == "LONG":
            highest_price = max(highest_price, high_p)
            stop_loss = max(stop_loss, highest_price - stop_dist) # ATR Trailing Stop Ratchet
            
            if low_p <= stop_loss:
                pnl = (stop_loss - entry_price) * units
                capital += pnl
                pnl_pct = ((stop_loss - entry_price) / entry_price) * 100.0
                status = f"EXIT LONG @ Rs.{stop_loss:.2f} (PnL: Rs.{pnl:+.2f})"
                
                # Log closed trade
                if current_trade:
                    current_trade["exit_bar"] = idx
                    current_trade["exit_time"] = candle_time_str
                    current_trade["exit_price"] = round(stop_loss, 2)
                    current_trade["exit_reason"] = "TRAILING_STOP_HIT"
                    current_trade["pnl"] = round(pnl, 2)
                    current_trade["pnl_pct"] = round(pnl_pct, 2)
                    current_trade["balance"] = round(capital, 2)
                    trades_log.append(current_trade)
                    current_trade = None
                
                position = None
                units = 0
            else:
                status = f"HOLD LONG | Stop: Rs.{stop_loss:.2f}"
                
        # --- ENTRY SIGNAL EVALUATION (Flat) ---
        else:
            vol_avg = sum(volumes[-20:]) / 20.0
            # MACD Bullish + RSI Filter + Volume Confirmation
            if macd > signal and (42.0 <= rsi <= 68.0) and vol > vol_avg:
                position = "LONG"
                units = req_units
                entry_price = close_p
                highest_price = high_p
                stop_loss = close_p - stop_dist
                status = f"BUY {units} Units @ Rs.{close_p:.2f}"
                
                # Start new trade record
                current_trade = {
                    "trade_id": len(trades_log) + 1,
                    "entry_bar": idx,
                    "entry_time": candle_time_str,
                    "entry_price": round(entry_price, 2),
                    "units": units,
                    "regime": regime,
                    "risk_engine": engine_name,
                    "exit_bar": None,
                    "exit_time": None,
                    "exit_price": None,
                    "exit_reason": None,
                    "pnl": 0.0,
                    "pnl_pct": 0.0,
                    "balance": round(capital, 2)
                }
            else:
                status = "NO SIGNAL"

        print(f"{idx:03d}   | {candle_time_str:<19} | Rs.{close_p:<7.2f} | {regime:<15} | {engine_name[:30]:<32} | {status}")

    # Mark-to-market close if still in position on the last candle
    if position == "LONG" and current_trade:
        final_price = closes[-1]
        pnl = (final_price - entry_price) * units
        capital += pnl
        pnl_pct = ((final_price - entry_price) / entry_price) * 100.0
        current_trade["exit_bar"] = len(candles) - 1
        current_trade["exit_time"] = format_candle_time(candles[-1][0])
        current_trade["exit_price"] = round(final_price, 2)
        current_trade["exit_reason"] = "BACKTEST_END_CLOSE"
        current_trade["pnl"] = round(pnl, 2)
        current_trade["pnl_pct"] = round(pnl_pct, 2)
        current_trade["balance"] = round(capital, 2)
        trades_log.append(current_trade)

    print("=" * 95)
    
    # Save trades locally
    save_trades_to_csv(trades_log, output_path=output_csv)
    
    # Print Backtest Performance Summary
    total_trades = len(trades_log)
    winning_trades = [t for t in trades_log if t["pnl"] > 0]
    losing_trades = [t for t in trades_log if t["pnl"] < 0]
    win_rate = (len(winning_trades) / total_trades * 100) if total_trades > 0 else 0.0
    total_profit = sum(t["pnl"] for t in winning_trades)
    total_loss = abs(sum(t["pnl"] for t in losing_trades))
    profit_factor = (total_profit / total_loss) if total_loss > 0 else (float("inf") if total_profit > 0 else 0.0)
    net_return_pct = ((capital - initial_capital) / initial_capital) * 100.0

    print("\n" + "=" * 50)
    print("         BACKTEST PERFORMANCE SUMMARY")
    print("=" * 50)
    print(f"  Initial Capital     : Rs. {initial_capital:,.2f}")
    print(f"  Final Capital       : Rs. {capital:,.2f}")
    print(f"  Net PnL             : Rs. {capital - initial_capital:+,.2f} ({net_return_pct:+.2f}%)")
    print(f"  Total Trades        : {total_trades}")
    print(f"  Winning Trades      : {len(winning_trades)}")
    print(f"  Losing Trades       : {len(losing_trades)}")
    print(f"  Win Rate            : {win_rate:.2f}%")
    print(f"  Profit Factor       : {profit_factor:.2f}")
    print(f"  Trade Data File     : {output_csv}")
    print("=" * 50 + "\n")

    return trades_log

